# ── Ask-AI chat (server-side proxy) ────────────────────────────────────────
# The legacy site called api.anthropic.com directly from the browser, which
# exposes the API key. In this Next.js version the call is proxied through
# /api/ai. Provide a key here to enable live responses; without it, the route
# returns a graceful mock reply so the UI still works in development.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Public site URL (used for metadata / canonical links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
